# ============================================================================
# BioAgents — Dante's local MacBook config
# ============================================================================
# Copy to `.env` and fill in the secrets. Designed for: personal, single-user,
# OpenAI-only, KNOWLEDGE literature backend, no S3, no Redis, no payments.
# ----------------------------------------------------------------------------

# ---- Auth (off for local dev) ----
AUTH_MODE=none
BIOAGENTS_SECRET=replace-with-output-of: openssl rand -hex 32
NODE_ENV=development
ALLOWED_ORIGINS=
MAX_JWT_EXPIRATION=3600

# ---- LLM providers (OpenAI everywhere) ----
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

REPLY_LLM_PROVIDER=openai
REPLY_LLM_MODEL=gpt-5.4
HYP_LLM_PROVIDER=openai
HYP_LLM_MODEL=gpt-5.4
PLANNING_LLM_PROVIDER=openai
PLANNING_LLM_MODEL=gpt-5.4
STRUCTURED_LLM_PROVIDER=openai
STRUCTURED_LLM_MODEL=gpt-5.4
DISCOVERY_LLM_PROVIDER=openai
DISCOVERY_LLM_MODEL=gpt-5.4
REFLECTION_LLM_PROVIDER=openai
REFLECTION_LLM_MODEL=gpt-5.4
PAPER_GEN_LLM_PROVIDER=openai
PAPER_GEN_LLM_MODEL=gpt-5.4

# Continue-research decision uses Anthropic by default. Override to OpenAI:
CONTINUE_RESEARCH_LLM_PROVIDER=openai
CONTINUE_RESEARCH_LLM_MODEL=gpt-5.4
MAX_AUTO_ITERATIONS=5

# /api/chat path uses Anthropic SDK directly. We won't use that route locally;
# leave the default value here. Use /api/deep-research instead.
CHAT_AGENT_MODEL=claude-sonnet-4-6
CHAT_AGENT_MAX_TOOL_CALLS=10
CHAT_AGENT_MAX_TOKENS=4096
CHAT_TOOL_TIMEOUT_MS=30000

PORT=3000

# ---- Supabase (local) ----
# Values printed by `supabase start` — see runbook step 3.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJ_FILL_ME_FROM_supabase_start
SUPABASE_SERVICE_KEY=eyJ_FILL_ME_FROM_supabase_start
SUPABASE_FULL_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Embeddings + KNOWLEDGE backend ----
EMBEDDING_PROVIDER=openai
TEXT_EMBEDDING_MODEL=text-embedding-3-large
COHERE_API_KEY=                    # optional; leave blank to skip reranking
USE_RERANKING=false                # flip to true if you set COHERE_API_KEY

CHUNK_SIZE=2000
CHUNK_OVERLAP=200
VECTOR_SEARCH_LIMIT=20
RERANK_FINAL_LIMIT=5
KNOWLEDGE_DOCS_PATH=docs
SIMILARITY_THRESHOLD=0.45
RERANKER_SCORE_THRESHOLD=0.3

PRIMARY_LITERATURE_AGENT=KNOWLEDGE
PRIMARY_ANALYSIS_AGENT=             # leave empty; we use the custom genomics agent

# ---- Optional remote agents (all OFF) ----
OPENSCHOLAR_API_URL=
OPENSCHOLAR_API_KEY=
EDISON_API_URL=
EDISON_API_KEY=
BIO_LIT_AGENT_API_URL=
BIO_LIT_AGENT_API_KEY=
DATA_ANALYSIS_API_URL=
DATA_ANALYSIS_API_KEY=

# ---- Storage (off) ----
STORAGE_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=

# ---- Payments (off) ----
X402_ENABLED=false
B402_ENABLED=false
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_PROJECT_ID=

# ---- Job queue (off) ----
USE_JOB_QUEUE=false
REDIS_URL=redis://localhost:6379

# ---- Character ----
CHARACTER_FILE=characters/dante-microbiome.json
AGENT_NAME=DanteBio
AGENT_EMAIL=dantericci@gmail.com

# ---- Custom: microbial ONT genomics pipeline ----
GENOMICS_PIPELINE_DIR=./pipelines/microbial_ont
GENOMICS_RUNS_DIR=./pipelines/microbial_ont/runs
GENOMICS_THREADS=8
GENOMICS_MAX_RAM_GB=12
